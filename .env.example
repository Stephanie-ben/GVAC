# Neon PostgreSQL connection string. Copy this file to .env and replace the
# placeholder with the production connection string provided by Neon.
# Never commit .env or a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Admin authentication. Used only by the API. Never put these values in frontend code.
# Choose your own usernames and strong passwords. SESSION_SECRET should be a long random string.
SESSION_SECRET=
ADMIN_FINANCIAL_SECRETARY_USERNAME=
ADMIN_FINANCIAL_SECRETARY_PASSWORD=
ADMIN_TREASURER_USERNAME=
ADMIN_TREASURER_PASSWORD=

# Optional. Origin of the Vite frontend for cookie-based admin login, e.g. http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Set to true behind HTTPS so the admin session cookie is marked Secure.
# COOKIE_SECURE=true
